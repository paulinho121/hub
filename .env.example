# Exemplo de configuração de ambiente
# Copie este arquivo para .env e preencha com suas chaves reais

# Supabase (Frontend e Backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL do Backend de IA (Ex: http://localhost:8787 para dev local)
VITE_AI_API_URL=http://localhost:8787

# Gemini API Key (Usada apenas pelo ai-server)
GEMINI_API_KEY=your-gemini-api-key
